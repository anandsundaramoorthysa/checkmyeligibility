# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Connection string from your Neon project dashboard
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Embeddings (Google Gemini) ───────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# ─── LLM primary (Groq) ───────────────────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ─── Vector database (Qdrant Cloud) ───────────────────────────────────────────
# Get from: https://cloud.qdrant.io → your cluster → API Keys
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Collection name — leave as default unless you need a custom name
# QDRANT_COLLECTION=scheme_embeddings

# ─── Admin key (protects /api/embed routes) ───────────────────────────────────
# Generate: openssl rand -hex 32
# Used as the X-Admin-Key header when seeding embeddings
CHATBOT_ADMIN_KEY=your-strong-random-secret
